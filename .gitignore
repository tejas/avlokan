# This repository is the archive: the catalogues, the generator that turns
# them into a website, and the website itself. Everything below is either the
# raw material those were made from, a machine's working state, or a copy git
# already keeps for us.

# The recordings themselves. Hundreds of gigabytes; the originals belong on
# the drive, not in a repository.
/originals/
/inbox/
/work/

# The pipeline's output folders. Two files of each are kept, but not from here:
# outputs/ entries are symlinks into ~/Pravachan Process, which git cannot track
# through. avlokan_site/sync_transcripts.py copies the timed transcript and the
# note of restored recitations into transcripts/, which is tracked. That keeps a
# correction a diff in the history, and lets the site be built from a clone.
/outputs/


# The transcription pipeline and its local app. Kept out for now so this
# repository stays about the archive rather than the machine that made it.
/avlokan_cli/
/avlokan_app/
/pyproject.toml
/queue*.txt
/PRODUCT.md
/DESIGN.md
/docs/

# Local pipeline settings: an absolute path to this machine and private
# spreadsheet links. Nothing the site needs.
/avlokan/settings.json
/avlokan/queue.json

# Timestamped copies written before each data change. Git is the history now.
*.backup-*.json

.venv*/
__pycache__/
*.pyc
.DS_Store

# Downloaded model weights.
/.hf-cache/
